{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rainbow Application Portal Applications Conversations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openrainbow.com/api/rainbow/enduser/v1.0/conversations",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of conversations to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ]
          },
          "docs": "Returns the list of conversations for the authenticated user, ordered by most recent activity."
        }
      ]
    }
  ],
  "bundled": true
}